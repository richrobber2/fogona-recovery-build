soong_namespace {
}

// Host-only source integration check, excluded from the recovery image.
cc_binary_host {
    name: "fogona-vintf-parser-test",
    srcs: ["tests/vintf_parser_test.cpp"],
    shared_libs: ["libvintf"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_binary {
    name: "fogona-check-keymint",
    recovery: true,
    srcs: ["crypto/check-keymint.cpp"],
    // patch-build.py installs this shared, locally tested polling policy.
    include_dirs: ["system/vold"],
    shared_libs: ["libdl"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
